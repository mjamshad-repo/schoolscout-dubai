# Copy to .env for local runs. On Vercel, add these under Project > Settings > Environment Variables.
# Set ONE provider key. Gemini and Groq have free tiers.

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: force a provider (gemini | groq | anthropic | mock)
# AI_PROVIDER=gemini

# Optional: questions per minute per visitor (default 8)
# RATE_LIMIT_PER_MIN=8
