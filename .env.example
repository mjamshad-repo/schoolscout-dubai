# Copy to .env for local runs. On Vercel, add these under Project > Settings > Environment Variables.
# Set ONE provider key. Gemini and Groq have free tiers.

GEMINI_API_KEY=
# Models tried in order (each has its own free daily quota):
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemma-4-31b-it,gemini-2.5-flash

# Optional extra free fallbacks (tried first when set; neither trains on prompts):
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_MODEL=@cf/openai/gpt-oss-120b

# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: custom order, e.g. AI_ORDER=groq,gemini:gemini-3.5-flash-lite,cloudflare
# Optional: AI_PROVIDER=mock for local testing without keys

# Optional: questions per minute per visitor (default 8)
# RATE_LIMIT_PER_MIN=8
